{
  "type": "object",
  "properties": {
    "workspaceId": {
      "type": "string",
      "minLength": 1
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "industry": {
            "type": "string",
            "minLength": 1
          },
          "employees": {
            "type": "number",
            "minimum": 0
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "accountId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "linkedin": {
            "type": "string",
            "format": "uri"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "roleConfirmed": {
            "type": "boolean"
          },
          "doNotContact": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "accountId",
          "name"
        ]
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "contactId": {
            "type": "string",
            "minLength": 1
          },
          "channel": {
            "enum": [
              "linkedin",
              "email",
              "crm",
              "calendar"
            ]
          },
          "direction": {
            "enum": [
              "inbound",
              "outbound",
              "internal"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "text": {
            "type": "string",
            "maxLength": 20000
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "meetingId": {
            "type": "string",
            "minLength": 1
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "source",
          "contactId",
          "channel",
          "direction",
          "at",
          "text"
        ]
      }
    },
    "commitments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "contactId": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "dueAt": {
            "type": "string",
            "format": "date-time"
          },
          "confirmed": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "open",
              "fulfilled",
              "cancelled"
            ]
          },
          "evidenceId": {
            "type": "string",
            "minLength": 1
          },
          "evidenceSource": {
            "type": "string",
            "minLength": 1
          },
          "fulfilledEvidenceId": {
            "type": "string",
            "minLength": 1
          },
          "fulfilledEvidenceSource": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "contactId",
          "dueAt",
          "confirmed",
          "status",
          "evidenceId",
          "evidenceSource"
        ]
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "minLength": 1
          },
          "channel": {
            "enum": [
              "linkedin",
              "email",
              "crm",
              "calendar"
            ]
          },
          "syncedAt": {
            "type": "string",
            "format": "date-time"
          },
          "complete": {
            "type": "boolean"
          }
        },
        "required": [
          "accountId",
          "channel",
          "syncedAt",
          "complete"
        ]
      }
    }
  },
  "required": [
    "workspaceId",
    "asOf",
    "accounts",
    "contacts",
    "events",
    "commitments",
    "coverage"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GTM Context Engine dataset",
  "description": "Structural contract; engine validation also checks foreign keys, identity collisions and snapshot timing."
}
